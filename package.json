{
  "name": "meridian",
  "version": "1.0.0",
  "private": true,
  "description": "Goal-based investing dashboard: a React front end over a small Express mock API.",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "commonjs",
  "scripts": {
    "start": "concurrently -n api,web -c cyan,magenta -k \"node server/index.js\" \"vite client\"",
    "dev": "concurrently -n api,web -c cyan,magenta -k \"node --watch server/index.js\" \"vite client\"",
    "build": "tsc -b client && vite build client",
    "preview": "vite preview client",
    "lint": "oxlint client",
    "test": "vitest --root client",
    "test:run": "vitest run --root client"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@mantine/core": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tanstack/react-query": "^5.104.5",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
